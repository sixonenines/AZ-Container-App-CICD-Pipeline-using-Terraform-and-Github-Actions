# Copy to .env and fill in. bootstrap.sh sources this file.
# Subscription and tenant are read automatically from the logged-in `az` session,
# so they are NOT set here.

# Base name for all bootstrap resources. Per-env resource groups become
# <base>-dev / <base>-test / <base>-prod, and the state RG becomes <base>-tfstatestorage.
RESOURCE_GROUP_BASE_NAME="rg-myapp"

# Azure region for all resources.
LOCATION="westeurope"

# Storage account that holds Terraform remote state. Must be globally unique,
# 3-24 chars, lowercase letters and numbers only.
STORAGE_ACCOUNT_NAME="stmyapptfstate"

# Base name of the per-env blob container for state (becomes <name>-dev, etc.).
BLOB_CONTAINER_NAME="tfstate"

# Base names for the per-env managed identity and its OIDC federated credential
# (each becomes <name>-dev / -test / -prod).
MANAGED_IDENTITY_NAME="id-myapp-gh"
FEDERATED_CREDENTIAL_NAME="fc-myapp-gh"

# GitHub repo that the OIDC federated credentials and environment vars target.
GITHUB_OWNER="your-github-username"
GITHUB_REPO="your-repo-name"

# Optional: comma-separated GitHub usernames who must approve prod promotions
# (sets required reviewers on the "prod" environment). Leave blank to skip the gate.
PROD_REVIEWERS=""
# PROD_REVIWERS="alice,bob,.."
